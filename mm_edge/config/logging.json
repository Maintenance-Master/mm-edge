{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s [%(levelname)s] %(name)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "level": "INFO",
      "stream": "ext://sys.stdout"
    },
    "connectorsFile": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "default",
      "filename": "logs/connectors.log",
      "when": "D",
      "interval": 3,
      "backupCount": 7,
      "encoding": "utf-8"
    },
    "mmEdgeFile": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "default",
      "filename": "logs/mm_edge.log",
      "when": "D",
      "interval": 3,
      "backupCount": 7,
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "mm_edge": {
      "handlers": ["mmEdgeFile", "console"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["connectorsFile", "console"]
  }
}